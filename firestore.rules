rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isWorkspaceMember(workspace) {
      return isSignedIn()
        && request.auth.uid in workspace.memberIds;
    }

    function isWorkspaceActive(workspace) {
      return !('deletionPendingAt' in workspace);
    }

    function workspaceById(workspaceId) {
      return get(
        /databases/$(database)/documents/workspaces/$(workspaceId)
      ).data;
    }

    function isWorkspaceMemberById(workspaceId) {
      return isWorkspaceMember(workspaceById(workspaceId));
    }

    function canWriteWorkspaceData(workspaceId) {
      let workspace = workspaceById(workspaceId);
      return isWorkspaceMember(workspace) && isWorkspaceActive(workspace);
    }

    function workspaceIsPro(workspace) {
      return workspace.entitlement.tier == 'pro'
        && workspace.entitlement.expiresAt is timestamp
        && workspace.entitlement.expiresAt > request.time;
    }

    function hasValidUserPreferences(data) {
      return (
          !('activeWorkspaceId' in data)
          || data.activeWorkspaceId == null
          || data.activeWorkspaceId is string
        )
        && (
          !('quickLinksByWorkspace' in data)
          || data.quickLinksByWorkspace is map
        );
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'activeWorkspaceId',
          'quickLinksByWorkspace',
          'updatedAt'
        ])
        && hasValidUserPreferences(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'activeWorkspaceId',
          'quickLinksByWorkspace',
          'updatedAt'
        ])
        && hasValidUserPreferences(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /private/subscription {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /workspaces/{workspaceId} {
      allow create: if false;
      allow read: if isWorkspaceMember(resource.data);
      allow update: if isWorkspaceMember(resource.data)
        && isWorkspaceActive(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'milestoneTracking',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /financialYears/{year} {
        allow read: if isWorkspaceMemberById(workspaceId);
        allow write: if false;
      }

      match /achievements/{milestoneId} {
        allow read: if isWorkspaceMemberById(workspaceId);
        allow write: if canWriteWorkspaceData(workspaceId);
      }

      match /modelConfig/{configId} {
        allow read: if isWorkspaceMemberById(workspaceId);
        allow write: if canWriteWorkspaceData(workspaceId)
          && (
            configId != 'whatIfStrategies'
            || workspaceIsPro(workspaceById(workspaceId))
          );
      }

      // Model items are read here but mutated through the callable function so
      // each item and its financial-year projection commit atomically.
      match /{collectionId}/{document=**} {
        allow read: if (
          collectionId == 'modelAssets'
          || collectionId == 'modelLiabilities'
          || collectionId == 'modelIncome'
          || collectionId == 'modelExpenses'
          || collectionId == 'expenseTracking'
        )
          && isWorkspaceMemberById(workspaceId);
        allow write: if (
          collectionId == 'expenseTracking'
        )
          && canWriteWorkspaceData(workspaceId);
      }
    }

    match /workspaceInvites/{inviteId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
